# =============================================================================
# Borsa Bot — Ortam Değişkenleri Şablonu
# Bu dosyayı `.env` olarak kopyalayıp gerçek değerleri doldurun.
# `.env` dosyası ASLA git'e commit edilmez (.gitignore'da bulunur).
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL bağlantı bilgileri
# -----------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=borsa_bot
DB_USER=postgres
DB_PASSWORD=

# -----------------------------------------------------------------------------
# API Anahtarları (ücretsiz kayıt ile alınabilir)
# -----------------------------------------------------------------------------
# Alpha Vantage: günde 25 istek (https://www.alphavantage.co/support/#api-key)
ALPHA_VANTAGE_API_KEY=

# Reddit API (https://www.reddit.com/prefs/apps) — sentiment için
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=BorsaBot/1.0

# -----------------------------------------------------------------------------
# Uygulama davranış ayarları
# -----------------------------------------------------------------------------
DATA_REFRESH_INTERVAL=60          # Veri yenileme aralığı (saniye)
DISCREPANCY_THRESHOLD_PCT=0.5     # Kaynaklar arası fiyat farkı uyarı eşiği (%)
ALERT_DISCREPANCY_PCT=2.0         # Kaynaklar arası fiyat farkı alarm eşiği (%)
SOURCE_FAILURE_LIMIT=5            # Bir kaynak art arda kaç hata sonrası devre dışı

# -----------------------------------------------------------------------------
# İşlem ve otomasyon
# -----------------------------------------------------------------------------
# Mod: manual_parallel | semi_auto | full_auto | paper
TRADING_MODE=manual_parallel
RISK_THRESHOLD=50                 # Bu skorun üstündeki işlemler onay ister (0-100)
DAILY_TRADE_LIMIT=10              # Günlük maks otomatik işlem sayısı
MAX_DRAWDOWN_PCT=15               # Circuit breaker: bu % düşüşte bot durur
DEFAULT_COMMISSION_PCT=0.2        # Varsayılan işlem komisyonu %

# -----------------------------------------------------------------------------
# Aracı kurum (Faz 4'te aktive edilir — şimdilik boş bırakılır)
# -----------------------------------------------------------------------------
BROKER_NAME=
BROKER_API_KEY=                   # Üretimde OS keyring'de saklanır, burada boş
BROKER_API_SECRET=

# -----------------------------------------------------------------------------
# Güvenlik
# -----------------------------------------------------------------------------
ENCRYPTION_ENABLED=true           # API anahtarları OS keyring ile şifrelenir

# -----------------------------------------------------------------------------
# NLP modelleri (ilk çalıştırmada HuggingFace'ten otomatik indirilir ~500 MB)
# -----------------------------------------------------------------------------
NLP_MODEL_TR=savasy/bert-base-turkish-sentiment-cased
NLP_MODEL_EN=ProsusAI/finbert

# -----------------------------------------------------------------------------
# Otomatik güncelleme (GitHub Releases)
# -----------------------------------------------------------------------------
# Boş = app/__version__.py içindeki __repo__'dan üret (Selupucin/Borsatakip)
UPDATE_CHECK_URL=
UPDATE_CHECK_INTERVAL_HOURS=6
UPDATE_AUTO_CHECK=true
